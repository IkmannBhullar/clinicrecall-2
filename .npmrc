# Keep the dependency tree honest: pnpm's default strict node_modules layout means a package
# must declare a dependency to import it. This catches "works on my machine" bugs at install
# time rather than during a demo.
strict-peer-dependencies=false

# Allow pnpm to download and delegate to the exact version named in package.json's
# "packageManager" field, so every machine builds with pnpm 9.15.9 (SPEC section 3).
manage-package-manager-versions=true
