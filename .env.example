# =============================================================================================
# ClinicRecall — environment template
# =============================================================================================
#
# HOW THIS FILE IS USED
#   `make setup` copies this file to `.env` (only if `.env` does not already exist) and fills in
#   the values it can generate. `make supabase-start` then writes the real local Supabase keys
#   into `.env` and regenerates `apps/web/.env.local` from it.
#
#   You should not normally need to edit `.env` by hand for local development.
#
# THE ONE RULE
#   Never commit a real value. Only this template is tracked by git; `.env` is gitignored.
#   Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is readable by anyone
#   who opens your site. Never put a secret behind that prefix.
#
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------------------------

# Which environment this process is running as: development | test | production.
# Controls error verbosity and whether demo-only utilities (reset, run-job) are exposed.
APP_ENV=development

# Python log level: DEBUG | INFO | WARNING | ERROR.
# Note: regardless of level, a redaction filter strips emails and phone numbers from every log
# line, because patient contact details must never reach application logs (SPEC section 9).
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# SQLAlchemy connection string for the application schema.
# This points at the Postgres instance inside the local Supabase stack. `make supabase-start`
# overwrites this with the real value, including the port the CLI actually bound.
# Local default: postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres


# ---------------------------------------------------------------------------------------------
# Supabase (auth)
# ---------------------------------------------------------------------------------------------

# Base URL of the Supabase API gateway.
# Local:  http://127.0.0.1:54321
# Hosted: https://<your-project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Public, browser-safe key. Identifies the project; grants no privileges by itself.
# Safe to expose — it is also published as NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Full admin access to your Supabase project — it bypasses every access rule.
# Used by the seed script to create the demo user accounts, and by nothing else.
#
#   * Never expose this to the browser.
#   * Never give it a NEXT_PUBLIC_ prefix.
#   * Never reference it from any file under apps/web/.
#
# `scripts/check-bundle-secrets.sh` fails the build if this key ever appears in the compiled
# client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Expected `aud` (audience) claim on incoming access tokens. Supabase issues "authenticated"
# for signed-in users. The API rejects any token whose audience differs.
SUPABASE_JWT_AUD=authenticated

# Where the API fetches the public keys used to verify token signatures (JWKS).
# Leave blank to derive it automatically as ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=


# ---------------------------------------------------------------------------------------------
# API service configuration
# ---------------------------------------------------------------------------------------------

# Origin allowed to call the API from a browser. Anything else is refused by CORS.
# Must exactly match the scheme, host, and port the web app is served from.
WEB_ORIGIN=http://localhost:3000

# Public base URL of this API, used to build absolute links (for example the unsubscribe link
# inside reminder emails).
API_BASE_URL=http://127.0.0.1:8000

# Shared secret for the reminder job endpoint (POST /internal/jobs/process-reminders).
# Sent by the caller as the `X-Job-Token` header and compared in constant time.
# `make setup` generates a random value; replace it with your own for any shared environment.
JOB_TOKEN=

# Secret used to sign one-click unsubscribe links so they cannot be forged or enumerated.
# `make setup` generates a random value. Changing it invalidates previously issued links.
UNSUBSCRIBE_TOKEN_SECRET=


# ---------------------------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------------------------

# Which provider sends reminders: mock | resend | ses
#
# `mock` is the default and is fully functional: it renders the real email, stores it so the UI
# can display exactly what "went out", returns a synthetic message ID, and transitions the event
# SENT -> DELIVERED. The entire product is demoable on `mock` with no paid service and no
# network access, which is what SPEC constraint D2 requires.
EMAIL_PROVIDER=mock

# API key for a real provider. Leave blank when EMAIL_PROVIDER=mock.
EMAIL_PROVIDER_API_KEY=

# From-address used on outbound reminders.
EMAIL_FROM_ADDRESS=reminders@example.com
EMAIL_FROM_NAME=Green Valley Family Clinic


# ---------------------------------------------------------------------------------------------
# Browser-visible variables (compiled into the web bundle — never put a secret here)
# ---------------------------------------------------------------------------------------------
#
# `make supabase-start` regenerates apps/web/.env.local from the values above, so you normally
# do not set these by hand. They are listed here so the full set is documented in one place.

# Mirrors SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Mirrors SUPABASE_ANON_KEY. Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the browser sends API requests. Mirrors API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
